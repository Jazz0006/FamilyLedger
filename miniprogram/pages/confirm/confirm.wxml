<view class="page">
  <view wx:if="{{loading}}" class="card"><text class="muted">加载中…</text></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{!loading && requests.length === 0}}" class="card empty">当前没有待你处理的事项</view>

  <view wx:for="{{requests}}" wx:key="id" class="card">
    <view class="row">
      <view>
        <view class="section-title">{{item.title}}</view>
        <text class="muted">对方：{{item.otherPartyName}}</text>
      </view>
    </view>
    <view class="request-detail">{{item.description}}</view>
    <text wx:if="{{item.note}}" class="muted">备注：{{item.note}}</text>

    <button
      class="btn-primary"
      data-id="{{item.id}}"
      data-kind="{{item.actionKind}}"
      loading="{{actingId === item.id}}"
      disabled="{{actingId !== ''}}"
      bindtap="accept"
    >{{item.actionKind === 'VERIFY' ? '确认是这位对方' : '确认并记入账本'}}</button>

    <button
      wx:if="{{item.canReject}}"
      class="btn-danger"
      data-id="{{item.id}}"
      disabled="{{actingId !== ''}}"
      bindtap="reject"
    >拒绝这项变更</button>

    <button
      wx:if="{{item.canCancel}}"
      class="btn-danger"
      data-id="{{item.id}}"
      disabled="{{actingId !== ''}}"
      bindtap="cancel"
    >不是这位对方，取消本次邀请</button>
  </view>
</view>
