<view wx:if="{{loading}}" class="card"><text class="label">加载中…</text></view>
<view wx:elif="{{error}}" class="card"><text>{{error}}</text></view>
<block wx:else>
  <view class="card">
    <button class="btn-primary" bindtap="proposeAdd">发起新增本金</button>
    <button class="btn-secondary" bindtap="proposeRepay">发起归还本金</button>
  </view>
  <view class="card">
    <text class="label">账本事件</text>
    <view wx:for="{{events}}" wx:key="_id">
      <text>{{item.effectiveDate}} · {{item.eventType}}</text>
    </view>
  </view>
</block>
