<view class="page">
  <view wx:if="{{loading}}" class="card"><text class="muted">加载中…</text></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{success}}" class="success">{{success}}</view>

  <block wx:if="{{!loading}}">
    <view class="card">
      <view class="section-title">对方是谁</view>
      <view class="choice-row">
        <button class="choice {{mode === 'FIRST' ? 'active' : ''}}" data-mode="FIRST" bindtap="chooseMode">新联系人</button>
        <button class="choice {{mode === 'KNOWN' ? 'active' : ''}}" data-mode="KNOWN" bindtap="chooseMode" disabled="{{known.length === 0}}">已有往来人</button>
      </view>
      <picker wx:if="{{mode === 'KNOWN'}}" mode="selector" range="{{known}}" range-key="displayName" value="{{knownIndex}}" bindchange="onKnownChange">
        <view class="picker">{{known[knownIndex].displayName || '请选择'}}</view>
      </picker>
      <text wx:if="{{known.length === 0}}" class="muted">还没有已有往来人，第一次需要通过邀请确认身份。</text>
    </view>

    <view class="card">
      <view class="section-title">借款方向</view>
      <view class="choice-row">
        <button class="choice {{direction === 'LEND' ? 'active' : ''}}" data-direction="LEND" bindtap="chooseDirection">我借给别人</button>
        <button class="choice {{direction === 'BORROW' ? 'active' : ''}}" data-direction="BORROW" bindtap="chooseDirection">我向别人借</button>
      </view>
    </view>

    <view class="card">
      <view class="field">
        <text class="field-label">本金（元）</text>
        <input class="input" type="digit" placeholder="例如 20000" value="{{amountYuan}}" bindinput="onAmountInput" />
      </view>
      <view class="field">
        <text class="field-label">年利率（%）</text>
        <input class="input" type="digit" placeholder="例如 5" value="{{ratePercent}}" bindinput="onRateInput" />
      </view>
      <view class="field">
        <text class="field-label">生效日期</text>
        <picker mode="date" value="{{effectiveDate}}" bindchange="onDateChange">
          <view class="picker">{{effectiveDate}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">备注（可选）</text>
        <textarea class="input note" maxlength="500" placeholder="例如：装修借款" value="{{note}}" bindinput="onNoteInput"></textarea>
      </view>
      <button class="btn-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">发起确认</button>
    </view>

    <view wx:if="{{invitePath}}" class="card">
      <view class="section-title">发送邀请</view>
      <text class="muted">对方接受邀请后，这笔账仍不会立即生效；你还要在“待我确认”里核对对方身份。</text>
      <button class="btn-primary" open-type="share">发送给微信好友</button>
      <button class="btn-secondary" bindtap="copyInvite">复制小程序路径</button>
    </view>
  </block>
</view>
