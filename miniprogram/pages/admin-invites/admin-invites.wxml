<view wx:if="{{error}}" class="card"><text>{{error}}</text></view>
<view class="card">
  <text class="label">邀请管理</text>
  <view wx:for="{{members}}" wx:key="_id" class="row">
    <text>{{item.displayName}}</text>
    <button class="btn-secondary" size="mini" data-userid="{{item._id}}" bindtap="createInvite">创建邀请</button>
  </view>
</view>
