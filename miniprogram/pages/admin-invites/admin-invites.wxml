<view class="card">
  <text class="label">邀请新家庭成员</text>
  <input
    class="name-input"
    placeholder="输入称呼，例如“妈妈”"
    value="{{displayName}}"
    bindinput="onNameInput"
  />
  <button class="btn-primary" bindtap="createInvite" disabled="{{creating}}">
    创建一次性邀请
  </button>
  <text wx:if="{{error}}" class="error">{{error}}</text>
</view>

<view wx:if="{{inviteLink}}" class="card">
  <text class="label">邀请已创建，请分享给家人（仅显示一次）</text>
  <text class="link" selectable="true">{{inviteLink}}</text>
  <button class="btn-secondary" bindtap="copyLink">复制邀请链接</button>
</view>
