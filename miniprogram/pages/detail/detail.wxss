.metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
}

.event-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #eeeeee;
}

.mutation-entry {
  margin-top: 32rpx;
}

.mutation-card {
  border: 2rpx solid #dfe7e2;
}

.panel-heading {
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.close-button {
  margin: 0;
  padding: 8rpx 20rpx;
  min-height: 0;
  font-size: 26rpx;
  line-height: 1.5;
  color: #666666;
  background: #f2f3f5;
  border-radius: 999rpx;
}

.close-button::after {
  border: 0;
}

.mutation-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx;
  margin: 24rpx 0 32rpx;
}

.mutation-grid .choice {
  margin: 0;
  padding: 16rpx 8rpx;
  min-height: 76rpx;
  font-size: 26rpx;
  line-height: 1.35;
}

.choice.active {
  color: #ffffff;
  background: #07c160;
}

.field {
  margin-top: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.input,
.picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  background: #f7f8fa;
  border: 1rpx solid #e5e6eb;
  border-radius: 14rpx;
}

.note {
  min-height: 150rpx;
}

.choice-row {
  display: flex;
  gap: 16rpx;
}

.choice-row .choice {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
}

.hint,
.warning,
.empty {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
  line-height: 1.55;
  border-radius: 14rpx;
}

.hint {
  color: #666666;
  background: #f7f8fa;
}

.warning {
  color: #8a4b08;
  background: #fff5e6;
}

.empty {
  color: #888888;
  background: #f7f8fa;
}

.mutation-card .btn-primary,
.mutation-card .btn-secondary {
  margin-top: 28rpx;
}
