<view wx:if="{{loading}}" class="card"><text class="label">加载中…</text></view>
<view wx:elif="{{error}}" class="card"><text>{{error}}</text></view>
<block wx:else>
  <view class="card">
    <text class="label">全家当前应还合计</text>
    <view class="amount-hero">{{totalDue}}</view>
  </view>
  <view wx:for="{{members}}" wx:key="loanId" class="card"
        data-loanid="{{item.loanId}}" bindtap="openAccount">
    <text>{{item.displayName}}</text>
    <view class="amount-hero">{{item.totalDue}}</view>
  </view>
</block>
