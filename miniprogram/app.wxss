page {
  background: #f5f5f7;
  color: #1a1a1a;
  font-size: 30rpx;
  line-height: 1.5;
}

.page {
  padding: 24rpx 24rpx 48rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.amount-hero {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.2;
  margin: 12rpx 0;
}

.amount {
  font-size: 34rpx;
  font-weight: 600;
}

.label,
.muted {
  font-size: 26rpx;
  color: #777777;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-primary,
.btn-secondary,
.btn-danger {
  border-radius: 16rpx;
  font-size: 30rpx;
  margin-top: 16rpx;
}

.btn-primary {
  background: #07c160;
  color: #ffffff;
}

.btn-secondary {
  background: #eeeeef;
  color: #222222;
}

.btn-danger {
  background: #fff0f0;
  color: #b42318;
}

.input,
.picker {
  background: #f6f6f7;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  min-height: 44rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.error {
  color: #b42318;
  background: #fff0f0;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.success {
  color: #067647;
  background: #ecfdf3;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.empty {
  color: #888888;
  padding: 24rpx 0;
  text-align: center;
}
