# Copy this file to .env.local and fill in local values.
# .env.local is ignored by Git and must never be committed.

# Tencent CloudBase environment id (from CloudBase console)
CLOUDBASE_ENV_ID=your-env-id

# Canonical timezone for interest "natural day" boundaries. The current v2
# domain constant is Asia/Shanghai; do not change the accounting timezone
# without an explicit product/data-model decision and regenerated test vectors.
LEDGER_TIMEZONE=Asia/Shanghai
