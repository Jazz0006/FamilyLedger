# Normalize line endings to LF in the repo; check out native on Windows.
* text=auto eol=lf

# Explicitly LF for these
*.ts   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.wxml text eol=lf
*.wxss text eol=lf

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
