{
  "name": "family-ledger",
  "version": "0.2.0",
  "private": true,
  "description": "来往账 — mutually confirmed bilateral loan ledger for WeChat Mini Program",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "cloud/functions/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build",
    "test": "npm run test --workspaces --if-present",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
